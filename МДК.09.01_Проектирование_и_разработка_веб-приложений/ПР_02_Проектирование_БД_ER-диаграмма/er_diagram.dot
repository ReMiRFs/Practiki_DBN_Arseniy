digraph ER {
  graph [rankdir=LR, fontname="DejaVu Sans", bgcolor="white", pad=0.4, nodesep=0.6, ranksep=1.1, splines=spline,
         label="ER-диаграмма БД портала «Конференции.РФ»", labelloc=t, fontsize=20];
  node  [shape=plain, fontname="DejaVu Sans", fontsize=12];
  edge  [fontname="DejaVu Sans", fontsize=11, color="#374151", arrowhead=crow, arrowtail=tee, dir=both];

  roles [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="6">
    <tr><td colspan="3" bgcolor="#1e3a8a"><font color="white"><b>roles</b> (роли)</font></td></tr>
    <tr><td>PK</td><td align="left">id</td><td align="left" port="id">INTEGER</td></tr>
    <tr><td></td><td align="left">name</td><td align="left">TEXT, UNIQUE</td></tr></table>>];

  users [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="6">
    <tr><td colspan="3" bgcolor="#1e3a8a"><font color="white"><b>users</b> (пользователи)</font></td></tr>
    <tr><td>PK</td><td align="left">id</td><td align="left" port="id">INTEGER</td></tr>
    <tr><td></td><td align="left">login</td><td align="left">TEXT, UNIQUE</td></tr>
    <tr><td></td><td align="left">password_hash</td><td align="left">TEXT</td></tr>
    <tr><td></td><td align="left">full_name</td><td align="left">TEXT</td></tr>
    <tr><td></td><td align="left">email</td><td align="left">TEXT</td></tr>
    <tr><td></td><td align="left">phone</td><td align="left">TEXT</td></tr>
    <tr><td port="role_id">FK</td><td align="left">role_id</td><td align="left">INTEGER → roles.id</td></tr>
    <tr><td></td><td align="left">created_at</td><td align="left">DATETIME</td></tr></table>>];

  events [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="6">
    <tr><td colspan="3" bgcolor="#1e3a8a"><font color="white"><b>events</b> (мероприятия)</font></td></tr>
    <tr><td>PK</td><td align="left">id</td><td align="left" port="id">INTEGER</td></tr>
    <tr><td></td><td align="left">title</td><td align="left">TEXT</td></tr>
    <tr><td></td><td align="left">event_date</td><td align="left">DATE</td></tr>
    <tr><td></td><td align="left">place</td><td align="left">TEXT</td></tr>
    <tr><td></td><td align="left">description</td><td align="left">TEXT</td></tr></table>>];

  statuses [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="6">
    <tr><td colspan="3" bgcolor="#1e3a8a"><font color="white"><b>statuses</b> (статусы)</font></td></tr>
    <tr><td>PK</td><td align="left">id</td><td align="left" port="id">INTEGER</td></tr>
    <tr><td></td><td align="left">name</td><td align="left">TEXT, UNIQUE</td></tr></table>>];

  applications [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="6">
    <tr><td colspan="3" bgcolor="#b45309"><font color="white"><b>applications</b> (заявки)</font></td></tr>
    <tr><td>PK</td><td align="left">id</td><td align="left" port="id">INTEGER</td></tr>
    <tr><td port="user_id">FK</td><td align="left">user_id</td><td align="left">INTEGER → users.id</td></tr>
    <tr><td port="event_id">FK</td><td align="left">event_id</td><td align="left">INTEGER → events.id</td></tr>
    <tr><td port="status_id">FK</td><td align="left">status_id</td><td align="left">INTEGER → statuses.id</td></tr>
    <tr><td></td><td align="left">payment_method</td><td align="left">TEXT</td></tr>
    <tr><td></td><td align="left">comment</td><td align="left">TEXT, NULL</td></tr>
    <tr><td></td><td align="left">created_at</td><td align="left">DATETIME</td></tr></table>>];

  reviews [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="6">
    <tr><td colspan="3" bgcolor="#1e3a8a"><font color="white"><b>reviews</b> (отзывы)</font></td></tr>
    <tr><td>PK</td><td align="left">id</td><td align="left" port="id">INTEGER</td></tr>
    <tr><td port="application_id">FK</td><td align="left">application_id</td><td align="left">INTEGER, UNIQUE → applications.id</td></tr>
    <tr><td></td><td align="left">text</td><td align="left">TEXT</td></tr>
    <tr><td></td><td align="left">rating</td><td align="left">INTEGER (1–5)</td></tr>
    <tr><td></td><td align="left">created_at</td><td align="left">DATETIME</td></tr></table>>];

  roles:id:e -> users:role_id:w [label="1 : N"];
  users:id:e -> applications:user_id:w [label="1 : N"];
  events:id:e -> applications:event_id:w [label="1 : N"];
  statuses:id:e -> applications:status_id:w [label="1 : N"];
  applications:id:e -> reviews:application_id:w [label="1 : 0..1", arrowhead=teeodot];
}
