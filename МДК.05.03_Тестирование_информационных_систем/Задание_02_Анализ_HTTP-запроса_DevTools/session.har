ry","value":"Cookie"}],"content":{"size":3560,"mimeType":"text/html; charset=utf-8","compression":0,"text":"<!doctype html>\n<html lang=\"ru\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Конференции.РФ</title>\n  <link rel=\"stylesheet\" href=\"/static/style.css\">\n  <link rel=\"stylesheet\" href=\"/static/animations.css\">\n</head>\n<body>\n<header class=\"header\">\n  <div class=\"container header__inner\">\n    <a class=\"logo\" href=\"/\">Конференции<span>.РФ</span></a>\n    <button class=\"burger\" type=\"button\" aria-label=\"Меню\" aria-expanded=\"false\" aria-controls=\"main-nav\">\n      <span></span><span></span><span></span>\n    </button>\n    <nav class=\"nav\" id=\"main-nav\">\n      <a href=\"/\">Мероприятия</a>\n      \n        \n          <a href=\"/applications\">Мои заявки</a>\n          <a href=\"/applications/new\">Новая заявка</a>\n        \n        <span class=\"nav__user\">ivanov01</span>\n        <a href=\"/logout\">Выйти</a>\n      \n    </nav>\n  </div>\n</header>\n<main class=\"container main\">\n  \n    \n  \n  \n<h1>Мероприятия</h1>\n<p class=\"lead\">Выберите конференцию и подайте заявку на участие.</p>\n<div class=\"events\">\n  \n  <article class=\"event\">\n    <div class=\"event__date\">2026-10-10</div>\n    <h2 class=\"event__title\">ИИ в образовании</h2>\n    <div class=\"event__place\">Онлайн</div>\n    <p>Как нейросети меняют обучение программированию: кейсы преподавателей.</p>\n    <a class=\"btn\" href=\"/applications/new?event=3\">Подать заявку</a>\n  </article>\n  \n  <article class=\"event\">\n    <div class=\"event__date\">2026-11-20</div>\n    <h2 class=\"event__title\">Веб-разработка 2026</h2>\n    <div class=\"event__place\">Москва, Технопарк «Сколково»</div>\n    <p>Ежегодная конференция о современных веб-технологиях: фронтенд, бекенд, DevOps.</p>\n    <a class=\"btn\" href=\"/applications/new?event=1\">Подать заявку</a>\n  </article>\n  \n  <article class=\"event\">\n    <div class=\"event__date\">2026-12-05</div>\n    <h2 class=\"event__title\">Тестирование ПО: практика</h2>\n    <div class=\"event__place\">Санкт-Петербург, ЭКСПОФОРУМ</div>\n    <p>Доклады о ручном и автоматизированном тестировании, мастер-классы по Selenium.</p>\n    <a class=\"btn\" href=\"/applications/new?event=2\">Подать заявку</a>\n  </article>\n  \n  <article class=\"event\">\n    <div class=\"event__date\">2027-02-14</div>\n    <h2 class=\"event__title\">UX/UI Design Day</h2>\n    <div class=\"event__place\">Казань, IT-парк</div>\n    <p>Дизайн интерфейсов, исследования пользователей, дизайн-системы.</p>\n    <a class=\"btn\" href=\"/applications/new?event=4\">Подать заявку</a>\n  </article>\n  \n</div>\n\n</main>\n<footer class=\"footer\"><div class=\"container\">© 2026 Конференции.РФ — учебный проект</div></footer>\n<script>\n  // Бургер-меню для мобильной версии (ПР 13)\n  (function () {\n    const btn = document.querySelector('.burger'), nav = document.getElementById('main-nav');\n    btn.addEventListener('click', () => {\n      const open = nav.classList.toggle('is-open');\n      btn.setAttribute('aria-expanded', open);\n    });\n  })();\n</script>\n<script src=\"/static/animations.js\" defer></script>\n</body>\n</html>"},"headersSize":190,"bodySize":3560,"redirectURL":"","_transferSize":3750},"cache":{},"timings":{"dns":0.009,"connect":0.173,"ssl":1.333,"send":0,"wait":2.313,"receive":2.32},"_frameref":"frame@0b41d5dc29e2230016bdf4b52344ef89","_monotonicTime":3508.272,"_resourceType":"document","serverIPAddress":"127.0.0.1","_serverPort":5000,"_securityDetails":{}},{"pageref":"page@9be22937b370618b729eae86da2c4350","startedDateTime":"2026-10-29T10:23:56.758Z","time":9.871,"request":{"method":"GET","url":"http://127.0.0.1:5000/static/style.css","httpVersion":"HTTP/1.1","cookies":[{"name":"session","value":"eyJ1c2VyX2lkIjoyfQ.auMeuw.TcpDE4zzV9HKNd4yLVDnOfomnVs"}],"headers":[{"name":"Accept","value":"text/css,*/*;q=0.1"}