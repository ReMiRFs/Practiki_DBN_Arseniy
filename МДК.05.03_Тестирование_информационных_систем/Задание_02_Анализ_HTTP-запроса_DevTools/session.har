ontent=\"width=device-width, initial-scale=1\">\n  <title>Мои заявки — Конференции.РФ</title>\n  <link rel=\"stylesheet\" href=\"/static/style.css\">\n  <link rel=\"stylesheet\" href=\"/static/animations.css\">\n</head>\n<body>\n<header class=\"header\">\n  <div class=\"container header__inner\">\n    <a class=\"logo\" href=\"/\">Конференции<span>.РФ</span></a>\n    <button class=\"burger\" type=\"button\" aria-label=\"Меню\" aria-expanded=\"false\" aria-controls=\"main-nav\">\n      <span></span><span></span><span></span>\n    </button>\n    <nav class=\"nav\" id=\"main-nav\">\n      <a href=\"/\">Мероприятия</a>\n      \n        \n          <a href=\"/applications\">Мои заявки</a>\n          <a href=\"/applications/new\">Новая заявка</a>\n        \n        <span class=\"nav__user\">ivanov01</span>\n        <a href=\"/logout\">Выйти</a>\n      \n    </nav>\n  </div>\n</header>\n<main class=\"container main\">\n  \n    <div class=\"alert alert--success\">Заявка отправлена</div>\n  \n  \n<div class=\"page-head\">\n  <h1>Мои заявки</h1>\n  <a class=\"btn\" href=\"/applications/new\">+ Новая заявка</a>\n</div>\n\n<div class=\"cards\">\n  \n  <article class=\"card\">\n    <div class=\"card__top\">\n      <span class=\"card__num\">Заявка № 6</span>\n      <span class=\"badge badge--1\">Новая</span>\n    </div>\n    <h2 class=\"card__title\">UX/UI Design Day</h2>\n    <dl class=\"card__meta\">\n      <dt>Дата</dt><dd>2027-02-14</dd>\n      <dt>Место</dt><dd>Казань, IT-парк</dd>\n      <dt>Помещение</dt><dd>Малый зал</dd>\n      <dt>Оплата</dt><dd>Банковская карта</dd>\n      <dt>Создана</dt><dd>2026-10-29 13:23:55</dd>\n    </dl>\n    \n      <p class=\"muted\">Отзыв станет доступен после завершения мероприятия</p>\n    \n  </article>\n  \n  <article class=\"card\">\n    <div class=\"card__top\">\n      <span class=\"card__num\">Заявка № 2</span>\n      <span class=\"badge badge--3\">Завершено</span>\n    </div>\n    <h2 class=\"card__title\">ИИ в образовании</h2>\n    <dl class=\"card__meta\">\n      <dt>Дата</dt><dd>2026-10-10</dd>\n      <dt>Место</dt><dd>Онлайн</dd>\n      <dt>Помещение</dt><dd>Онлайн-трансляция</dd>\n      <dt>Оплата</dt><dd>Наличные на месте</dd>\n      <dt>Создана</dt><dd>2026-10-29 13:23:52</dd>\n    </dl>\n    \n      <div class=\"review\">\n        <div class=\"stars\">★★★★★</div>\n        <p>Очень полезные доклады, особенно про нейросети в обучении. Спасибо организаторам!</p>\n      </div>\n    \n  </article>\n  \n  <article class=\"card\">\n    <div class=\"card__top\">\n      <span class=\"card__num\">Заявка № 1</span>\n      <span class=\"badge badge--1\">Новая</span>\n    </div>\n    <h2 class=\"card__title\">Веб-разработка 2026</h2>\n    <dl class=\"card__meta\">\n      <dt>Дата</dt><dd>2026-11-20</dd>\n      <dt>Место</dt><dd>Москва, Технопарк «Сколково»</dd>\n      <dt>Помещение</dt><dd>Большой зал</dd>\n      <dt>Оплата</dt><dd>Банковская карта</dd>\n      <dt>Создана</dt><dd>2026-10-29 13:23:52</dd>\n    </dl>\n    \n      <p class=\"muted\">Отзыв станет доступен после завершения мероприятия</p>\n    \n  </article>\n  \n</div>\n\n\n</main>\n<footer class=\"footer\"><div class=\"container\">© 2026 Конференции.РФ — учебный проект</div></footer>\n<script>\n  // Бургер-меню для мобильной версии (ПР 13)\n  (function () {\n    const btn = document.querySelector('.burger'), nav = document.getElementById('main-nav');\n    btn.addEventListener('click', () => {\n      const open = nav.classList.toggle('is-open');\n      btn.setAttribute('aria-expanded', open);\n    });\n  })();\n</script>\n<script src=\"/static/animations.js\" defer></script>\n</body>\n</html>"},"headersSize":297,"bodySize":4146,"redirectURL":"","_transferSize":4443},"cache":{},"timings":{"dns":0.007,"connect":0.142,"ssl":1.328,"send":0,"wait":6.646,"receive":1.39},"_frameref":"frame@0b41d5dc29e2230016bdf4b52344ef89","_monotonicTime":2573.706,"_resourceType":"document","serverIPAddress":"127.0.0.1","_serverPort":5000,"_securityDetails":{}}