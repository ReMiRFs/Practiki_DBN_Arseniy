bKit/537.36 (KHTML, like Gecko) HeadlessChrome/153.0.8010.12 Safari/537.36"},{"name":"sec-ch-ua","value":"\"HeadlessChrome\";v=\"153\", \"Not_A Brand\";v=\"8\", \"Chromium\";v=\"153\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Linux\""}],"queryString":[],"headersSize":709,"bodySize":0},"response":{"status":304,"statusText":"NOT MODIFIED","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept-Ranges","value":"bytes"},{"name":"Cache-Control","value":"no-cache"},{"name":"Connection","value":"close"},{"name":"Content-Disposition","value":"inline; filename=animations.css"},{"name":"Date","value":"Thu, 29 Oct 2026 10:23:55 GMT"},{"name":"Date","value":"Thu, 29 Oct 2026 10:23:55 GMT"},{"name":"ETag","value":"\"1793268940.4171016-5162-2449805681\""},{"name":"Server","value":"Werkzeug/3.1.9 Python/3.13.18"},{"name":"Vary","value":"Cookie"}],"content":{"size":-1,"mimeType":"x-unknown","compression":0},"headersSize":320,"bodySize":0,"redirectURL":"","_transferSize":320},"cache":{},"timings":{"dns":0.004,"connect":0.127,"ssl":2.49,"send":0,"wait":7.45,"receive":2.69},"_frameref":"frame@0b41d5dc29e2230016bdf4b52344ef89","_monotonicTime":2211.035,"_resourceType":"stylesheet","serverIPAddress":"127.0.0.1","_serverPort":5000,"_securityDetails":{}},{"pageref":"page@9be22937b370618b729eae86da2c4350","startedDateTime":"2026-10-29T10:23:55.446Z","time":12.133,"request":{"method":"GET","url":"http://127.0.0.1:5000/static/validate.js","httpVersion":"HTTP/1.1","cookies":[{"name":"session","value":"eyJ1c2VyX2lkIjoyfQ.auMeug.DhwHkfBtTNEaApUQMs5CPSwMsAE"}],"headers":[{"name":"Accept","value":"*/*"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Connection","value":"keep-alive"},{"name":"Cookie","value":"session=eyJ1c2VyX2lkIjoyfQ.auMeug.DhwHkfBtTNEaApUQMs5CPSwMsAE"},{"name":"Host","value":"127.0.0.1:5000"},{"name":"Referer","value":"http://127.0.0.1:5000/applications/new"},{"name":"Sec-Fetch-Dest","value":"script"},{"name":"Sec-Fetch-Mode","value":"no-cors"},{"name":"Sec-Fetch-Site","value":"same-origin"},{"name":"User-Agent","value":"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/153.0.8010.12 Safari/537.36"},{"name":"sec-ch-ua","value":"\"HeadlessChrome\";v=\"153\", \"Not_A Brand\";v=\"8\", \"Chromium\";v=\"153\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Linux\""}],"queryString":[],"headersSize":589,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept-Ranges","value":"bytes"},{"name":"Cache-Control","value":"no-cache"},{"name":"Connection","value":"close"},{"name":"Content-Disposition","value":"inline; filename=validate.js"},{"name":"Content-Length","value":"2348"},{"name":"Content-Type","value":"text/javascript; charset=utf-8"},{"name":"Date","value":"Thu, 29 Oct 2026 10:23:55 GMT"},{"name":"Date","value":"Thu, 29 Oct 2026 10:23:55 GMT"},{"name":"ETag","value":"\"1793268670.2610126-2348-1586499612\""},{"name":"Last-Modified","value":"Thu, 29 Oct 2026 10:11:10 GMT"},{"name":"Server","value":"Werkzeug/3.1.9 Python/3.13.18"},{"name":"Vary","value":"Cookie"}],"content":{"size":2348,"mimeType":"text/javascript; charset=utf-8","compression":0,"text":"/* Клиентская валидация с выводом ошибок прямо под полями (ПР 9).\n   Серверная валидация сохраняется — клиентская лишь даёт быструю обратную связь. */\n(function () {\n  const rules = {\n    login:     v => /^[A-Za-z0-9]{6,}$/.test(v) || 'Логин: только латиница и цифры, не менее 6 символов',\n    password:  v => v.length >= 8 || 'Пароль должен содержать не менее 8 символов',\n    full_name: v => /^[А-Яа-яЁё\\- ]+$/.test(v) && v.trim() !== '' || 'ФИО: только кириллица, пробелы и дефис',\n    phone:     v => /^8\\(\\d{3}\\)\\d{3}-\\d{2}-\\d{2}$/.test(v) || 'Телефон в формате 8(XXX)XXX-XX-XX',\n    email:     v => /^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(v) || 'Введите email в формате name@example.ru',\n    event_id:  v => v !== '' || 'Выберите мероприятие из списка',\n    payment_method: v => v !== '' || 'Выберите способ оплаты',\n    hall:      v => v !== '' || 'Выберите помещение',\n    rating:    v => v !== '' || 'Поставьте оценку от 1 до 5',\n    text:      v => v.trim().length >= 10 || 'Отзыв должен содержать не менее 10 символов',\n  };\n\n  function check(el) {\n    const rule = rules[el.name];\n    if (!rule) return true;\n    const res = rule(el.value);\n    const box = el.closest('.field');\n    const err = box && box.querySelector('.field__error');\n    const ok = res === true;\n    if (box) box.classList.toggle('field--error', !ok);\n    if (err) err.textContent = ok ? '' : res;\n    return ok;\n  }\n\n  document.querySelectorAll('form[data-validate]').forEach(form => {\n    form.querySelectorAll('input, select, textarea').forEach(el => {\n      el.addEventListener('blur', () => check(el));\n      el.addEventListener('input', () => { if (el.closest('.field--error')) check(el); });\n    });\n    form.addEventListener('submit', e => {\n      let firstBad = null;\n      form.querySelectorAll('input, select, textarea').forEach(el => {\n        if (!check(el) && !firstBad) firstBad = el;\n      });\n      if (firstBad) { e.preventDefault(); firstBad.focus(); }\n    });\n  });\n})();\n"},"headersSize":421,"bodySize":2348,"redirectURL":"","_transferSize":2769},"cache":{},"timings":{"dns":0.005,"connect":0.199,"ssl":2.218,"send":0,"wait":2.994,"receive":6.717},"_frameref":"frame@0b41d5dc29e2230016bdf4b52344ef89","_monotonicTime":2211.078,"_resourceType":"script","serverIPAddress":"127.0.0.1","_serverPort":5000,"_securityDetails":{}},{"pageref":"page@9be22937b370618b729eae86da2c4350","startedDateTime":"2026-10-29T10:23:55.446Z","time":17.893,"request":{"method":"GET","url":"http://127.0.0.1:5000/static/animations.js","httpVersion":"HTTP/1.1","cookies":[{"name":"session","value":"eyJ1c2VyX2lkIjoyfQ.auMeug.DhwHkfBtTNEaApUQMs5CPSwMsAE"}],"headers":[{"name"