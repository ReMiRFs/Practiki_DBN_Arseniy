{"log":{"version":"1.2","creator":{"name":"Playwright","version":"1.63.0"},"browser":{"name":"chromium","version":"153.0.8010.12"},"pages":[{"startedDateTime":"2026-10-29T10:23:53.669Z","id":"page@9be22937b370618b729eae86da2c4350","title":"Конференции.РФ","pageTimings":{"onContentLoad":3108,"onLoad":3108}}],"entries":[{"pageref":"page@9be22937b370618b729eae86da2c4350","startedDateTime":"2026-10-29T10:23:53.784Z","time":9.489,"request":{"method":"GET","url":"http://127.0.0.1:5000/","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Connection","value":"keep-alive"},{"name":"Host","value":"127.0.0.1:5000"},{"name":"Sec-Fetch-Dest","value":"document"},{"name":"Sec-Fetch-Mode","value":"navigate"},{"name":"Sec-Fetch-Site","value":"none"},{"name":"Sec-Fetch-User","value":"?1"},{"name":"Upgrade-Insecure-Requests","value":"1"},{"name":"User-Agent","value":"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/153.0.8010.12 Safari/537.36"},{"name":"sec-ch-ua","value":"\"HeadlessChrome\";v=\"153\", \"Not_A Brand\";v=\"8\", \"Chromium\";v=\"153\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Linux\""}],"queryString":[],"headersSize":629,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Connection","value":"close"},{"name":"Content-Length","value":"3445"},{"name":"Content-Type","value":"text/html; charset=utf-8"},{"name":"Date","value":"Thu, 29 Oct 2026 10:23:53 GMT"},{"name":"Server","value":"Werkzeug/3.1.9 Python/3.13.18"},{"name":"Vary","value":"Cookie"}],"content":{"size":3445,"mimeType":"text/html; charset=utf-8","compression":0,"text":"<!doctype html>\n<html lang=\"ru\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Конференции.РФ</title>\n  <link rel=\"stylesheet\" href=\"/static/style.css\">\n  <link rel=\"stylesheet\" href=\"/static/animations.css\">\n</head>\n<body>\n<header class=\"header\">\n  <div class=\"container header__inner\">\n    <a class=\"logo\" href=\"/\">Конференции<span>.РФ</span></a>\n    <button class=\"burger\" type=\"button\" aria-label=\"Меню\" aria-expanded=\"false\" aria-controls=\"main-nav\">\n      <span></span><span></span><span></span>\n    </button>\n    <nav class=\"nav\" id=\"main-nav\">\n      <a href=\"/\">Мероприятия</a>\n      \n        <a href=\"/login\">Вход</a>\n        <a class=\"btn btn--small\" href=\"/register\">Регистрация</a>\n      \n    </nav>\n  </div>\n</header>\n<main class=\"container main\">\n  \n    \n  \n  \n<h1>Мероприятия</h1>\n<p class=\"lead\">Выберите конференцию и подайте заявку на участие.</p>\n<div class=\"events\">\n  \n  <article class=\"event\">\n    <div class=\"event__date\">2026-10-10</div>\n    <h2 class=\"event__title\">ИИ в образовании</h2>\n    <div class=\"event__place\">Онлайн</div>\n    <p>Как нейросети меняют обучение программированию: кейсы преподавателей.</p>\n    <a class=\"btn\" href=\"/applications/new?event=3\">Подать заявку</a>\n  </article>\n  \n  <article class=\"event\">\n    <div class=\"event__date\">2026-11-20</div>\n    <h2 class=\"event__title\">Веб-разработка 2026</h2>\n    <div class=\"event__place\">Москва, Технопарк «Сколково»</div>\n    <p>Ежегодная конференция о современных веб-технологиях: фронтенд, бекенд, DevOps.</p>\n    <a class=\"btn\" href=\"/applications/new?event=1\">Подать заявку</a>\n  </article>\n  \n  <article class=\"event\">\n    <div class=\"event__date\">2026-12-05</div>\n    <h2 class=\"event__title\">Тестирование ПО: практика</h2>\n    <div class=\"event__place\">Санкт-Петербург, ЭКСПОФОРУМ</div>\n    <p>Доклады о ручном и автоматизированном тестировании, мастер-классы по Selenium.</p>\n    <a class=\"btn\" href=\"/applications/new?event=2\">Подать заявку</a>\n  </article>\n  \n  <article class=\"event\">\n    <div class=\"event__date\">2027-02-14</div>\n    <h2 class=\"event__title\">UX/UI Design Day</h2>\n    <div class=\"event__place\">Казань, IT-парк</div>\n    <p>Дизайн интерфейсов, исследования пользователей, дизайн-системы.</p>\n    <a class=\"btn\" href=\"/applications/new?event=4\">Подать заявку</a>\n  </article>\n  \n</div>\n\n</main>\n<footer class=\"footer\"><div class=\"container\">© 2026 Конференции.РФ — учебный проект</div></footer>\n<script>\n  // Бургер-меню для мобильной версии (ПР 13)\n  (function () {\n    const btn = document.querySelector('.burger'), nav = document.getElementById('main-nav');\n    btn.addEventListener('click', () => {\n      const open = nav.classList.toggle('is-open');\n      btn.setAttribute('aria-expanded', open);\n    });\n  })();\n</script>\n<script src=\"/static/animations.js\" defer></script>\n</body>\n</html>"},"headersSize":190,"bodySize":3445,"redirectURL":"","_transferSize":3635},"cache":{},"timings":{"dns":0.034,"connect":0.217,"ssl":5.445,"send":0,"wait":2.288,"receive":1.505},"_frameref":"frame@0b41d5dc29e2230016bdf4b52344ef89","_monotonicTime":551.756,"_resourceType":"document","serverIPAddress":"127.0.0.1","_serverPort":5000,"_securityDetails":{}},{"pageref":"page@9be22937b370618b729eae86da2c4350","startedDateTime":"2026-10-29T10:23:53.803Z","time":23.767,"request":{"method":"GET","url":"http://127.0.0.1:5000/static/style.css","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"text/css,*/*;q=0.1"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Connection","value":"keep-alive"},{"name":"Host","value":"127.0.0.1:5000"},{"name":"Referer","value":"http://127.0.0.1:5000/"},{"name":"Sec-Fetch-Dest","value":"style"},{"name":"Sec-Fetch-Mode","value":"no-cors"},{"name":"Sec-Fetch-Site","value":"same-origin"},{"name":"User-Agent","value":"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/153.0.8010.12 Safari/537.36"},{"name":"sec-ch-ua","value":"\"HeadlessChrome\";v=\"153\", \"Not_A Brand\";v=\"8\", \"Chromium\";v=\"153\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Linux\""}],"queryString":[],"headersSize":514,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept-Ranges","value":"bytes"},{"name":"Cache-Control","value":"no-cache"},{"name":"Connection","value":"close"},{"name":"Content-Disposition","value":"inline; filename=style.css"},{"name":"Content-Length","value":"6912"},{"name":"Content-Type","value":"text/css; charset=utf-8"},{"name":"Date","value":"Thu, 29 Oct 2026 10:23:53 GMT"},{"name":"Date","value":"Thu, 29 Oct 2026 10:23:53 GMT"},{"name":"ETag","value":"\"1793268670.2609804-6912-1058803567\""},{"name":"Last-Modified","value":"Thu, 29 Oct 2026 10:11:10 GMT"},{"name":"Server","value":"Werkzeug/3.1.9 Python/3.13.18"},{"name":"Vary","value":"Cookie"}],"content":{"size":6912,"mimeType":"text/css; charset=utf-8","compression":0,"text":"/* Конференции.РФ — базовые стили (ПР 3) */\n* { box-sizing: border-box; }\nbody { margin: 0; font-family: Arial, sans-serif; color: #1f2937; background: #f3f4f6; }\na { color: #1d4ed8; }\n.container { width: 100%; max-width: 1040px; margin: 0 auto; padding: 0 20px; }\n.header { background: #1e3a8a; color: #fff; }\n.header__inner { display: flex; justify-content: space-between; align-items: center; height: 64px; }\n.logo { color: #fff; font-size: 22px; font-weight: bold; text-decoration: none; }\n.logo span { color: #fbbf24; }\n.nav a, .nav__user { color: #fff; margin-left: 18px; text-decoration: none; }\n.nav__user { opacity: .7; }\n.main { padding: 24px 0 48px; min-height: 70vh; }\n.lead { color: #4b5563; }\n.events { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }\n.event { background: #fff; padding: 20px; border-radius: 6px; }\n.event__date { color: #b45309; font-weight: bold; }\n.event__title { margin: 6px 0; font-size: 20px; }\n.event__place { color: #6b7280; }\n.btn { display: inline-block; background: #1d4ed8; color: #fff; border: 0; padding: 10px 18px;\n       border-radius: 4px; text-decoration: none; cursor: pointer; font-size: 15px; }\n.btn--small { padding: 6px 12px; font-size: 14px; }\n.nav .btn { color: #fff; background: #fbbf24; color: #1e3a8a; }\n.form { background: #fff; padding: 24px; width: 100%; max-width: 460px; border-radius: 6px; }\n.form label { display: block; margin-bottom: 14px; font-weight: bold; }\n.form input, .form select, .form textarea { display: block; width: 100%; margin-top: 4px; padding: 8px;\n       border: 1px solid #9ca3af; border-radius: 4px; font: inherit; font-weight: normal; }\n.alert { padding: 10px 14px; margin-bottom: 10px; border-radius: 4px; }\n.alert--error { background: #fee2e2; color: #991b1b; }\n.alert--success { background: #dcfce7; color: #166534; }\n.table { width: 100%; background: #fff; border-collapse: collapse; }\n.table th, .table td { border: 1px solid #e5e7eb; padding: 8px; text-align: left; vertical-align: top; }\n.table th { background: #e0e7ff; }\n.inline { display: flex; gap: 6px; }\n.footer { background: #111827; color: #9ca3af; padding: 16px 0; font-size: 14px; }\n\n/* ---------- ПР 9: поля с ошибками, карточки, фильтр ---------- */\n.field { margin-bottom: 14px; }\n.field label { display: block; font-weight: bold; margin-bottom: 4px; }\n.form .field label { margin-bottom: 4px; }\n.field input, .field select, .field textarea { display: block; width: 100%; padding: 8px;\n       border: 1px solid #9ca3af; border-radius: 4px; font: inherit; }\n.field__hint { color: #6b7280; }\n.field__error { color: #b91c1c; font-size: 14px; min-height: 0; margin-top: 4px; }\n.field--error input, .field--error select, .field--error textarea { border-color: #dc2626; background: #fef2f2; }\n.page-head { display: flex; justify-content: space-between; align-items: center; }\n.cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }\n.card { background: #fff; border-radius: 8px; padding: 18px; box-shadow: 0 1px 3px rgba(0,0,0,.08); }\n.card__top { display: flex; justify-content: space-between; align-items: center; }\n.card__num { color: #6b7280; font-size: 14px; }\n.card__title { font-size: 18px; margin: 8px 0 10px; }\n.card__meta { display: grid; grid-template-columns: 110px 1fr; gap: 4px 10px; margin: 0 0 12px; font-size: 14px; }\n.card__meta dt { color: #6b7280; }\n.card__meta dd { margin: 0; }\n.badge { padding: 3px 10px; border-radius: 12px; font-size: 13px; font-weight: bold; }\n.badge--1 { background: #dbeafe; color: #1e40af; }\n.badge--2 { background: #fef3c7; color: #92400e; }\n.badge--3 { background: #dcfce7; color: #166534; }\n.filter { display: flex; gap: 8px; align-items: center; margin-bottom: 18px; flex-wrap: wrap; }\n.filter__item { padding: 6px 14px; border-radius: 16px; background: #fff; text-decoration: none; border: 1px solid #c7d2fe; }\n.filter__item.is-active { background: #1d4ed8; color: #fff; border-color: #1d4ed8; }\n.filter__count { margin-left: auto; color: #6b7280; }\n.review { background: #f9fafb; border-left: 3px solid #fbbf24; padding: 8px 12px; margin-bottom: 12px; }\n.review p { margin: 4px 0 0; }\n.stars { color: #f59e0b; letter-spacing: 2px; }\n.muted { color: #9ca3af; font-size: 14px; }\n\n\n/* ---------- ПР 13: адаптивная вёрстка ---------- */\nimg { max-width: 100%; height: auto; }\n.burger { display: none; }\n.events, .cards { grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }\n.field input, .field select, .field textarea, .btn { min-height: 44px; }  /* удобная зона касания */\n.btn--small { min-height: 36px; }\n\n@media (max-width: 768px) {\n  .header__inner { height: 56px; position: relative; }\n  .burger { display: flex; flex-direction: column; justify-content: center; gap: 5px;\n            width: 44px; height: 44px; background: transparent; border: 0; cursor: pointer; padding: 10px; }\n  .burger span { display: block; height: 2px; background: #fff; border-radius: 2px; }\n  .nav { display: none; position: absolute; top: 56px; left: -20px; right: -20px; z-index: 10;\n         background: #1e3a8a; flex-direction: column; padding: 8px 20px 16px;\n         box-shadow: 0 8px 16px rgba(0,0,0,.2); }\n  .nav.is-open { display: flex; }\n  .nav a, .nav__user { margin: 0; padding: 12px 0; border-bottom: 1px solid rgba(255,255,255,.15); }\n  .nav .btn { margin-top: 10px; text-align: center; border: 0; }\n  h1 { font-size: 24px; }\n  .page-head { flex-direction: column; align-items: stretch; gap: 8px; margin-bottom: 16px; }\n  .page-head h1 { margin-bottom: 4px; }\n  .page-head .btn { text-align: center; }\n}\n\n@media (max-width: 480px) {\n  .container { padding: 0 16px; }\n  .main { padding: 16px 16px 32px; }\n  .events, .cards { grid-template-columns: 1fr; gap: 14px; }\n  .event, .card { padding: 16px; }\n  .form { padding: 18px 16px; max-width: none; }\n  .form .btn { width: 100%; }\n  .field input, .field select, .field textarea { font-size: 16px; } /* iOS не масштабирует поле */\n  .card__meta { grid-template-columns: 96px 1fr; }\n  .filter { flex-wrap: nowrap; overflow-x: auto; padding-bottom: 6px; -webkit-overflow-scrolling: touch; }\n  .filter__item { white-space: nowrap; }\n  .filter__count { display: none; }\n  .inline { flex-direction: column; }\n  .inline .btn { width: 100%; }\n  .footer { text-align: center; }\n}\n.btn { display: inline-flex; align-items: center; justify-content: center; }\n.inline select { flex: 1; min-height: 40px; padding: 6px 8px; border: 1px solid #9ca3af; border-radius: 4px; font: inherit; background: #fff; }\nbody { min-height: 100vh; display: flex; flex-direction: column; }\n.main { flex: 1; min-height: 0; }\n@media (max-width: 768px) {\n  .header { position: relative; }\n  .header__inner { position: static; }\n  .nav { left: 0; right: 0; padding: 8px 20px 16px; }\n}\n@media (max-width: 480px) { .nav { padding: 8px 16px 16px; } }\n"},"headersSize":412,"bodySize":6912,"redirectURL":"","_transferSize":7324},"cache":{},"timings":{"dns":0.006,"connect":1.698,"ssl":3.52,"send":0,"wait":8.03,"receive":10.513},"_frameref":"frame@0b41d5dc29e2230016bdf4b52344ef89","_monotonicTime":567.486,"_resourceType":"stylesheet","serverIPAddress":"127.0.0.1","_serverPort":5000,"_securityDetails":{}},{"pageref":"page@9be22937b370618b729eae86da2c4350","startedDateTime":"2026-10-29T10:23:53.803Z","time":25.597,"request":{"method":"GET","url":"http://127.0.0.1:5000/static/animations.css","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"text/css,*/*;q=0.1"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Connection","value":"keep-alive"},{"name":"Host","value":"127.0.0.1:5000"},{"name":"Referer","value":"http://127.0.0.1:5000/"},{"name":"Sec-Fetch-Dest","value":"style"},{"name":"Sec-Fetch-Mode","value":"no-cors"},{"name":"Sec-Fetch-Site","value":"same-origin"},{"name":"User-Agent","value":"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/153.0.8010.12 Safari/537.36"},{"name":"sec-ch-ua","value":"\"HeadlessChrome\";v=\"153\", \"Not_A Brand\";v=\"8\", \"Chromium\";v=\"153\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Linux\""}],"queryString":[],"headersSize":519,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept-Ranges","value":"bytes"},{"name":"Cache-Control","value":"no-cache"},{"name":"Connection","value":"close"},{"name":"Content-Disposition","value":"inline; filename=animations.css"},{"name":"Content-Length","value":"5162"},{"name":"Content-Type","value":"text/css; charset=utf-8"},{"name":"Date","value":"Thu, 29 Oct 2026 10:23:53 GMT"},{"name":"Date","value":"Thu, 29 Oct 2026 10:23:53 GMT"},{"name":"ETag","value":"\"1793268940.4171016-5162-2449805681\""},{"name":"Last-Modified","value":"Thu, 29 Oct 2026 10:15:40 GMT"},{"name":"Server","value":"Werkzeug/3.1.9 Python/3.13.18"},{"name":"Vary","value":"Cookie"}],"content":{"size":5162,"mimeType":"text/css; charset=utf-8","compression":0,"text":"/* ===== ПР 14: анимации и микро-анимации =====\n   Анимируются только transform и opacity — их браузер обрабатывает на GPU,\n   поэтому перерисовки (layout/paint) не происходит и FPS не проседает. */\n\n:root { --ease: cubic-bezier(.2, .8, .2, 1); --fast: 150ms; --base: 300ms; }\n\n/* 1. Переход между страницами: плавное появление и исчезновение контента */\n@keyframes page-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }\n.main { animation: page-in var(--base) var(--ease) backwards; }\nbody.is-leaving .main { opacity: 0; transform: translateY(-6px);\n  transition: opacity 180ms ease, transform 180ms ease; }\n\n/* 2. Каскадное появление карточек */\n@keyframes card-in { from { opacity: 0; transform: translateY(16px) scale(.98); } to { opacity: 1; transform: none; } }\n.event, .card { animation: card-in 400ms var(--ease) backwards; animation-delay: calc(var(--i, 0) * 60ms); }\n\n/* 3. Карточки: подъём при наведении */\n.event, .card { transition: transform var(--base) var(--ease), box-shadow var(--base) var(--ease); }\n@media (hover: hover) {\n  .event:hover, .card:hover { transform: translateY(-4px); box-shadow: 0 10px 24px rgba(30, 58, 138, .12); }\n}\n\n/* 4. Кнопки: наведение, нажатие, «волна» от клика */\n.btn { position: relative; overflow: hidden;\n  transition: transform var(--fast) var(--ease), box-shadow var(--fast) var(--ease), filter var(--fast); }\n@media (hover: hover) { .btn:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(29, 78, 216, .3); filter: brightness(1.08); } }\n.btn:active { transform: scale(.97); box-shadow: none; }\n.ripple { position: absolute; border-radius: 50%; background: rgba(255, 255, 255, .45);\n  transform: scale(0); animation: ripple 500ms ease-out forwards; pointer-events: none; }\n@keyframes ripple { to { transform: scale(4); opacity: 0; } }\n\n/* 5. Поля формы: плавная подсветка фокуса и «встряхивание» при ошибке */\n.field input, .field select, .field textarea, .inline select {\n  transition: border-color var(--fast), box-shadow var(--fast), background-color var(--fast); }\n.field input:focus, .field select:focus, .field textarea:focus, .inline select:focus {\n  outline: none; border-color: #1d4ed8; box-shadow: 0 0 0 3px rgba(29, 78, 216, .2); }\n@keyframes shake { 20%, 60% { transform: translateX(-5px); } 40%, 80% { transform: translateX(5px); } }\n.field.shake input, .field.shake select, .field.shake textarea { animation: shake 320ms ease; }\n@keyframes err-in { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }\n.field--error .field__error { animation: err-in 200ms ease backwards; }\n\n/* 6. Уведомления (flash) выезжают сверху и сами скрываются */\n@keyframes alert-in { from { opacity: 0; transform: translateY(-12px); } to { opacity: 1; transform: none; } }\n.alert { animation: alert-in 300ms var(--ease) backwards; transition: opacity 300ms, transform 300ms; }\n.alert.is-hiding { opacity: 0; transform: translateY(-8px); }\n\n/* 7. Бейдж «Новая» мягко пульсирует, привлекая внимание администратора */\n@keyframes pulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(30, 64, 175, .35); } 50% { box-shadow: 0 0 0 6px rgba(30, 64, 175, 0); } }\n.badge--1 { animation: pulse 2.4s ease-in-out infinite; }\n\n/* 8. Фильтр статусов */\n.filter__item { transition: background-color var(--fast), color var(--fast), transform var(--fast); }\n.filter__item:active { transform: scale(.95); }\n\n/* 9. Бургер превращается в крестик, меню выезжает */\n.burger span { transition: transform var(--base) var(--ease), opacity var(--fast); }\n.burger[aria-expanded=\"true\"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }\n.burger[aria-expanded=\"true\"] span:nth-child(2) { opacity: 0; }\n.burger[aria-expanded=\"true\"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }\n@keyframes menu-in { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: none; } }\n.nav.is-open { animation: menu-in 220ms var(--ease) both; }\n\n/* 10. Звёзды в отзыве появляются по очереди */\n@keyframes star-pop { 0% { transform: scale(0); } 70% { transform: scale(1.3); } 100% { transform: scale(1); } }\n.stars span { display: inline-block; animation: star-pop 300ms var(--ease) both; animation-delay: calc(var(--s) * 80ms + 300ms); }\n\n/* Доступность: пользователи с настройкой «уменьшить движение» видят интерфейс без анимаций */\n@media (prefers-reduced-motion: reduce) {\n  *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important;\n    transition-duration: .01ms !important; animation-delay: 0ms !important; }\n}\n"},"headersSize":417,"bodySize":5162,"redirectURL":"","_transferSize":5579},"cache":{},"timings":{"dns":0.007,"connect":0.403,"ssl":1.517,"send":0,"wait":10.081,"receive":13.589},"_frameref":"frame@0b41d5dc29e2230016bdf4b52344ef89","_monotonicTime":567.676,"_resourceType":"stylesheet","serverIPAddress":"127.0.0.1","_serverPort":5000,"_securityDetails":{}},{"pageref":"page@9be22937b370618b729eae86da2c4350","startedDateTime":"2026-10-29T10:23:53.803Z","time":25.469,"request":{"method":"GET","url":"http://127.0.0.1:5000/static/animations.js","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"*/*"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Connection","value":"keep-alive"},{"name":"Host","value":"127.0.0.1:5000"},{"name":"Referer","value":"http://127.0.0.1:5000/"},{"name":"Sec-Fetch-Dest","value":"script"},{"name":"Sec-Fetch-Mode","value":"no-cors"},{"name":"Sec-Fetch-Site","value":"same-origin"},{"name":"User-Agent","value":"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/153.0.8010.12 Safari/537.36"},{"name":"sec-ch-ua","value":"\"HeadlessChrome\";v=\"153\", \"Not_A Brand\";v=\"8\", \"Chromium\";v=\"153\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Linux\""}],"queryString":[],"headersSize":504,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept-Ranges","value":"bytes"},{"name":"Cache-Control","value":"no-cache"},{"name":"Connection","value":"close"},{"name":"Content-Disposition","value":"inline; filename=animations.js"},{"name":"Content-Length","value":"2921"},{"name":"Content-Type","value":"text/javascript; charset=utf-8"},{"name":"Date","value":"Thu, 29 Oct 2026 10:23:53 GMT"},{"name":"Date","value":"Thu, 29 Oct 2026 10:23:53 GMT"},{"name":"ETag","value":"\"1793268670.2650723-2921-2158104837\""},{"name":"Last-Modified","value":"Thu, 29 Oct 2026 10:11:10 GMT"},{"name":"Server","value":"Werkzeug/3.1.9 Python/3.13.18"},{"name":"Vary","value":"Cookie"}],"content":{"size":2921,"mimeType":"text/javascript; charset=utf-8","compression":0,"text":"/* ПР 14: управление анимациями (переходы между страницами, ripple, shake, автоскрытие уведомлений) */\n(function () {\n  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n  // каскадная задержка для карточек\n  document.querySelectorAll('.event, .card').forEach((el, i) => el.style.setProperty('--i', Math.min(i, 8)));\n\n  // звёзды рейтинга — по одной\n  document.querySelectorAll('.stars').forEach(box => {\n    box.innerHTML = [...box.textContent.trim()].map((ch, i) => `<span style=\"--s:${i}\">${ch}</span>`).join('');\n  });\n\n  // плавный уход со страницы при переходе по внутренним ссылкам\n  document.addEventListener('click', e => {\n    const a = e.target.closest('a[href]');\n    if (!a || reduce || e.ctrlKey || e.metaKey || e.shiftKey || a.target === '_blank') return;\n    const url = new URL(a.href, location.href);\n    if (url.origin !== location.origin || url.href === location.href) return;\n    e.preventDefault();\n    document.body.classList.add('is-leaving');\n    setTimeout(() => { location.href = url.href; }, 170);\n  });\n  // возврат кнопкой «Назад» из bfcache — снимаем состояние ухода\n  window.addEventListener('pageshow', () => document.body.classList.remove('is-leaving'));\n\n  // «волна» от точки клика по кнопке\n  document.addEventListener('pointerdown', e => {\n    const btn = e.target.closest('.btn');\n    if (!btn || reduce) return;\n    const r = btn.getBoundingClientRect(), size = Math.max(r.width, r.height);\n    const s = document.createElement('span');\n    s.className = 'ripple';\n    s.style.cssText = `width:${size}px;height:${size}px;left:${e.clientX - r.left - size / 2}px;top:${e.clientY - r.top - size / 2}px`;\n    btn.appendChild(s);\n    s.addEventListener('animationend', () => s.remove());\n  });\n\n  // встряхнуть поля с ошибками (и после серверной проверки, и после клиентской)\n  function shake(field) {\n    field.classList.remove('shake'); void field.offsetWidth; field.classList.add('shake');\n    field.addEventListener('animationend', () => field.classList.remove('shake'), { once: true });\n  }\n  document.querySelectorAll('.field--error').forEach(shake);\n  document.querySelectorAll('form[data-validate]').forEach(form =>\n    form.addEventListener('submit', () => setTimeout(() =>\n      form.querySelectorAll('.field--error').forEach(shake), 0)));\n\n  // уведомления об успехе исчезают через 4 секунды\n  document.querySelectorAll('.alert--success').forEach(al => setTimeout(() => {\n    al.classList.add('is-hiding');\n    al.addEventListener('transitionend', () => al.remove(), { once: true });\n  }, 4000));\n})();\n"},"headersSize":423,"bodySize":2921,"redirectURL":"","_transferSize":3344},"cache":{},"timings":{"dns":0.005,"connect":0.065,"ssl":1.183,"send":0,"wait":12.533,"receive":11.683},"_frameref":"frame@0b41d5dc29e2230016bdf4b52344ef89","_monotonicTime":567.802,"_resourceType":"script","serverIPAddress":"127.0.0.1","_serverPort":5000,"_securityDetails":{}},{"pageref":"page@9be22937b370618b729eae86da2c4350","startedDateTime":"2026-10-29T10:23:54.346Z","time":4.768,"request":{"method":"GET","url":"http://127.0.0.1:5000/login","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Connection","value":"keep-alive"},{"name":"Host","value":"127.0.0.1:5000"},{"name":"Sec-Fetch-Dest","value":"document"},{"name":"Sec-Fetch-Mode","value":"navigate"},{"name":"Sec-Fetch-Site","value":"none"},{"name":"Sec-Fetch-User","value":"?1"},{"name":"Upgrade-Insecure-Requests","value":"1"},{"name":"User-Agent","value":"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/153.0.8010.12 Safari/537.36"},{"name":"sec-ch-ua","value":"\"HeadlessChrome\";v=\"153\", \"Not_A Brand\";v=\"8\", \"Chromium\";v=\"153\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Linux\""}],"queryString":[],"headersSize":634,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Connection","value":"close"},{"name":"Content-Length","value":"1833"},{"name":"Content-Type","value":"text/html; charset=utf-8"},{"name":"Date","value":"Thu, 29 Oct 2026 10:23:54 GMT"},{"name":"Server","value":"Werkzeug/3.1.9 Python/3.13.18"},{"name":"Vary","value":"Cookie"}],"content":{"size":1833,"mimeType":"text/html; charset=utf-8","compression":0,"text":"<!doctype html>\n<html lang=\"ru\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Вход — Конференции.РФ</title>\n  <link rel=\"stylesheet\" href=\"/static/style.css\">\n  <link rel=\"stylesheet\" href=\"/static/animations.css\">\n</head>\n<body>\n<header class=\"header\">\n  <div class=\"container header__inner\">\n    <a class=\"logo\" href=\"/\">Конференции<span>.РФ</span></a>\n    <button class=\"burger\" type=\"button\" aria-label=\"Меню\" aria-expanded=\"false\" aria-controls=\"main-nav\">\n      <span></span><span></span><span></span>\n    </button>\n    <nav class=\"nav\" id=\"main-nav\">\n      <a href=\"/\">Мероприятия</a>\n      \n        <a href=\"/login\">Вход</a>\n        <a class=\"btn btn--small\" href=\"/register\">Регистрация</a>\n      \n    </nav>\n  </div>\n</header>\n<main class=\"container main\">\n  \n    \n  \n  \n<h1>Вход</h1>\n<form method=\"post\" class=\"form\">\n  <label>Логин <input name=\"login\" required></label>\n  <label>Пароль <input type=\"password\" name=\"password\" required></label>\n  <button class=\"btn\" type=\"submit\">Войти</button>\n  <p>Ещё нет аккаунта? <a href=\"/register\">Зарегистрироваться</a></p>\n</form>\n\n</main>\n<footer class=\"footer\"><div class=\"container\">© 2026 Конференции.РФ — учебный проект</div></footer>\n<script>\n  // Бургер-меню для мобильной версии (ПР 13)\n  (function () {\n    const btn = document.querySelector('.burger'), nav = document.getElementById('main-nav');\n    btn.addEventListener('click', () => {\n      const open = nav.classList.toggle('is-open');\n      btn.setAttribute('aria-expanded', open);\n    });\n  })();\n</script>\n<script src=\"/static/animations.js\" defer></script>\n</body>\n</html>"},"headersSize":190,"bodySize":1833,"redirectURL":"","_transferSize":2023},"cache":{},"timings":{"dns":0.008,"connect":0.165,"ssl":1.28,"send":0,"wait":2.403,"receive":0.912},"_frameref":"frame@0b41d5dc29e2230016bdf4b52344ef89","_monotonicTime":1107.446,"_resourceType":"document","serverIPAddress":"127.0.0.1","_serverPort":5000,"_securityDetails":{}},{"pageref":"page@9be22937b370618b729eae86da2c4350","startedDateTime":"2026-10-29T10:23:54.356Z","time":7.5569999999999995,"request":{"method":"GET","url":"http://127.0.0.1:5000/static/style.css