\n  \n  \n<h1>Новая заявка</h1>\n<form method=\"post\" class=\"form\" novalidate data-validate=\"application\">\n  <div class=\"field \">\n    <label for=\"event_id\">Мероприятие</label>\n    <select id=\"event_id\" name=\"event_id\">\n      <option value=\"\">— выберите мероприятие —</option>\n      \n      <option value=\"3\" >ИИ в образовании (2026-10-10)</option>\n      \n      <option value=\"1\" >Веб-разработка 2026 (2026-11-20)</option>\n      \n      <option value=\"2\" >Тестирование ПО: практика (2026-12-05)</option>\n      \n      <option value=\"4\" >UX/UI Design Day (2027-02-14)</option>\n      \n    </select>\n    <div class=\"field__error\"></div>\n  </div>\n  <div class=\"field \">\n    <label for=\"payment_method\">Способ оплаты</label>\n    <select id=\"payment_method\" name=\"payment_method\">\n      <option value=\"\">— выберите способ оплаты —</option>\n      <option >Банковская карта</option><option >Наличные на месте</option><option >Безналичный расчёт (для организаций)</option>\n    </select>\n    <div class=\"field__error\"></div>\n  </div>\n  <div class=\"field \">\n    <label for=\"hall\">Помещение</label>\n    <select id=\"hall\" name=\"hall\">\n      <option value=\"\">— выберите помещение —</option>\n      <option >Большой зал</option><option >Малый зал</option><option >Онлайн-трансляция</option>\n    </select>\n    <div class=\"field__error\"></div>\n  </div>\n  <div class=\"field \">\n    <label for=\"comment\">Комментарий <small>(необязательно)</small></label>\n    <textarea id=\"comment\" name=\"comment\" rows=\"3\" maxlength=\"500\"></textarea>\n    <div class=\"field__error\"></div>\n  </div>\n  <button class=\"btn\" type=\"submit\">Отправить заявку</button>\n</form>\n<script src=\"/static/validate.js\"></script>\n\n</main>\n<footer class=\"footer\"><div class=\"container\">© 2026 Конференции.РФ — учебный проект</div></footer>\n<script>\n  // Бургер-меню для мобильной версии (ПР 13)\n  (function () {\n    const btn = document.querySelector('.burger'), nav = document.getElementById('main-nav');\n    btn.addEventListener('click', () => {\n      const open = nav.classList.toggle('is-open');\n      btn.setAttribute('aria-expanded', open);\n    });\n  })();\n</script>\n<script src=\"/static/animations.js\" defer></script>\n</body>\n</html>"},"headersSize":190,"bodySize":3559,"redirectURL":"","_transferSize":3749},"cache":{},"timings":{"dns":0.01,"connect":0.173,"ssl":1.324,"send":0,"wait":8.427,"receive":2.307},"_frameref":"frame@0b41d5dc29e2230016bdf4b52344ef89","_monotonicTime":2188.441,"_resourceType":"document","serverIPAddress":"127.0.0.1","_serverPort":5000,"_securityDetails":{}},{"pageref":"page@9be22937b370618b729eae86da2c4350","startedDateTime":"2026-10-29T10:23:55.445Z","time":11.902,"request":{"method":"GET","url":"http://127.0.0.1:5000/static/style.css","httpVersion":"HTTP/1.1","cookies":[{"name":"session","value":"eyJ1c2VyX2lkIjoyfQ.auMeug.DhwHkfBtTNEaApUQMs5CPSwMsAE"}],"headers":[{"name":"Accept","value":"text/css,*/*;q=0.1"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Connection","value":"keep-alive"},{"name":"Cookie","value":"session=eyJ1c2VyX2lkIjoyfQ.auMeug.DhwHkfBtTNEaApUQMs5CPSwMsAE"},{"name":"Host","value":"127.0.0.1:5000"},{"name":"If-Modified-Since","value":"Thu, 29 Oct 2026 10:11:10 GMT"},{"name":"If-None-Match","value":"\"1793268670.2609804-6912-1058803567\""},{"name":"Referer","value":"http://127.0.0.1:5000/applications/new"},{"name":"Sec-Fetch-Dest","value":"style"},{"name":"Sec-Fetch-Mode","value":"no-cors"},{"name":"Sec-Fetch-Site","value":"same-origin"},{"name":"User-Agent","value":"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/153.0.8010.12 Safari/537.36"},{"name":"sec-ch-ua","value":"\"HeadlessChrome\";v=\"153\", \"Not_A Brand\";v=\"8\", \"Chromium\";v=\"153\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Linux\""}],"queryString":[],"headersSize":704,"bodySize":0},